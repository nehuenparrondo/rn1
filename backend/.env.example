# backend/.env.example — Variables privadas; copiar a backend/.env y editar.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Orígenes web exactos separados por comas; no usar *.
CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083,http://192.168.1.2:8083
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TIMEOUT_MS=5000
DB_NAME=np_user_access
DB_USER=np_login_app
# Usar la misma contraseña privada de create_app_user.local.sql; nunca la del seed.
DB_PASSWORD=REEMPLAZAR_POR_PASSWORD_LOCAL
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12
